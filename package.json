{
  "name": "verso-ts",
  "version": "0.2.1",
  "description": "In-source type tests for TypeScript: assertions live beside the code they check and vanish from the build.",
  "keywords": [
    "typescript",
    "types",
    "type-testing",
    "type-tests",
    "in-source-testing",
    "assertions",
    "tsc",
    "testing"
  ],
  "homepage": "https://github.com/CO0Ki3/verso#readme",
  "bugs": {
    "url": "https://github.com/CO0Ki3/verso/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CO0Ki3/verso.git"
  },
  "license": "MIT",
  "author": "co0ki3 (https://github.com/CO0Ki3)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "verso": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src/index.ts",
    "LLM.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "pnpm verso && pnpm lint && pnpm format:check && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint",
    "prepublishOnly": "pnpm check && pnpm build",
    "test": "vitest run",
    "verso": "node src/cli.ts"
  },
  "peerDependencies": {
    "typescript": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxlint": "1.90.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
